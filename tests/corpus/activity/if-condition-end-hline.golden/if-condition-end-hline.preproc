@startuml
skinparam conditionEndStyle hline
start
if (Ready?) then (yes)
  :Launch;
else (no)
  :Wait;
endif
if (Again?) then (yes)
  :Repeat;
endif
if (Valid?) then (yes)
  :Save;
else (no)
  :Reject;
  stop
endif
if (Text A) then (yes)
  :Text 1;
elseif (Text B) then (yes)
  :Text 2;
else (no)
  :Text 3;
endif
stop
@enduml
