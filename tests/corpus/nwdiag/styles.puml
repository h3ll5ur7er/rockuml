@startnwdiag
<style>
nwdiagDiagram {
  network {
    BackGroundColor lightblue
    LineColor navy
    FontColor navy
  }
  server {
    BackGroundColor pink
    FontStyle bold
  }
  arrow {
    FontColor red
    LineColor red
  }
  group {
    BackGroundColor gold
    LineColor black
  }
}
</style>
nwdiag {
  group g1 {
    description = "Group"
    s1;
  }
  network n1 {
    address = "10.0.0.0/8"
    s1 [address = "10.0.0.1"];
    s2 [address = "10.0.0.2"];
  }
}
@endnwdiag
