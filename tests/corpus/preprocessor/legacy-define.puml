@startuml
!define SHOW(x) participant x
!define LINK(a, b) a -> b : linked
!define CONST value_of_const
!definelong LONG(x)
participant x
x -> x : long body
!enddefinelong
!definelong SHORTLONG(y)
y -> y : single line definelong
!enddefinelong
SHOW(Alice)
LINK(Alice, Bob)
LONG(Carl)
SHORTLONG(Dora)
A -> B : CONST and CONST2
