@startuml
A -> B : darken=%darken("DodgerBlue", 20) %darken("#ABC", 50) lighten=%lighten("red", 30) %lighten("#123456", 75)
A -> B : dark=%is_dark("navy") %is_dark("yellow") light=%is_light("white") %is_light("#000")
A -> B : reverse=%reverse_color("#336699") %reverse_color("lime") hsluv=%reverse_hsluv_color("#336699") %reverse_hsluv_color("gold")
