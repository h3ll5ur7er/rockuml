<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" version="1.1" style="width:792px;height:204px;background:#000000;" width="792px" height="204px" viewBox="0 0 792 204" zoomAndPan="magnify" preserveAspectRatio="none" contentStyleType="text/css"><?plantuml 1.2026.8?><defs/><g font-family="sans-serif" lengthAdjust="spacing"><text x="5" y="17" fill="#33FF02" font-size="12" textLength="327.45" font-weight="700" font-style="italic">PlantUML version 1.2026.8 / 149874a [2026-09-05 15:59:17 UTC]</text><rect x="5" y="25" width="781.025" height="19" fill="#33FF02" style="stroke:#33FF02;stroke-width:1;"/><text x="6" y="40" fill="#000" font-size="14" textLength="187.513" font-weight="700">[From builtins-json.puml (line 9) ]</text><text x="5" y="58" fill="#33FF02" font-size="14" font-weight="700"> </text><text x="5" y="72" fill="#33FF02" font-size="14" textLength="63.962" font-weight="700">@startuml</text><text x="5" y="86" fill="#33FF02" font-size="14" textLength="409.15" font-weight="700">!$data = {"name": "rock", "tags": ["a", "b"], "nested": {"x": 1, "y": {"z": true}}}</text><text x="5" y="100" fill="#33FF02" font-size="14" textLength="528.587" font-weight="700">A -> B : name=$data.name tag=$data.tags[1] nested=$data.nested.x whole=$data.nested</text><text x="5" y="114" fill="#33FF02" font-size="14" textLength="781.025" font-weight="700">A -> B : keys=%get_json_keys($data) types=%get_json_type($data) %get_json_type($data.tags) %get_json_type("s") %get_json ...</text><text x="5" y="128" fill="#33FF02" font-size="14" textLength="71.838" font-weight="700">!$k = "name"</text><text x="5" y="142" fill="#33FF02" font-size="14" textLength="368.112" font-weight="700">A -> B : by_key=$data[$k] index_expr=$data.tags[%strlen("x")]</text><text x="5" y="156" fill="#33FF02" font-size="14" textLength="223.475" font-weight="700">!$added = %json_add($data.tags, "c")</text><text x="5" y="170" fill="#33FF02" font-size="14" textLength="248.063" font-weight="700">A