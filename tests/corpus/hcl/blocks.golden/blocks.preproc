@starthcl
provider "aws" {
  region = "us-east-1"
}

variable "image_id" {
  type    = string
  default = "ami-a1b2c3d4"
}

variable "zone" {
  default = "us-east-1a"
}

variable "image_id" {
  description = "the second block of the same name replaces the first"
}

output "instance_ip" {
  value = aws_instance.web.private_ip
}
@endhcl
