{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "rockuml-angular": {
      "projectType": "library",
      "root": "projects/rockuml-angular",
      "sourceRoot": "projects/rockuml-angular/src",
      "prefix": "rockuml",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/rockuml-angular/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/rockuml-angular/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/rockuml-angular/tsconfig.spec.json",
            "include": ["**/*.spec.ts", "../editor/**/*.spec.ts"]
          }
        }
      }
    },
    "site": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/site",
      "sourceRoot": "projects/site/src",
      "prefix": "site",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/site/src/main.ts",
            "tsConfig": "projects/site/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/site/public"
              },
              {
                "glob": "rockuml.wasm",
                "input": "node_modules/rockuml",
                "output": "/"
              }
            ],
            "styles": ["projects/site/src/styles.css"],
            "loader": {
              ".md": "text"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "site:build:production"
            },
            "development": {
              "buildTarget": "site:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/site/tsconfig.spec.json"
          }
        }
      }
    }
  }
}
